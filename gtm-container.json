        "tag": [
            {
                "accountId": "6383589568",
                "containerId": "267708902",
                "tagId": "7",
                "name": "HTML - Transform Add to Cart",
                "type": "html",
                "parameter": [
                    {
                        "type": "TEMPLATE",
                        "key": "html",
                        "value": "<script>\n  (function () {\n    function toNumber(value) {\n      if (typeof value === \"number\") {\n        return value;\n      }\n      if (typeof value === \"string\" && value.trim() !== \"\") {\n        return Number(value);\n      }\n      return NaN;\n    }\n\n    var eventParams;\n    try {\n      eventParams = JSON.parse({{CJS - Event Params JSON}});\n    } catch (error) {\n      console.warn(\"add_to_cart not sent: event parameters are missing or invalid.\");\n      return;\n    }\n\n    if (!eventParams || !Array.isArray(eventParams.items) ||\n        typeof eventParams.currency !== \"string\" || eventParams.currency === \"\") {\n      console.warn(\"add_to_cart not sent: items or currency are missing.\", eventParams);\n      return;\n    }\n\n    console.log(\"Original event parameters:\", eventParams);\n\n    var totalCents = 0;\n    var updatedItems = [];\n\n    for (var i = 0; i < eventParams.items.length; i++) {\n      var item = eventParams.items[i];\n\n      if (!item || typeof item !== \"object\") {\n        console.warn(\"add_to_cart not sent: item \" + i + \" is not an object.\", item);\n        return;\n      }\n\n      var price = toNumber(item.price);\n      var missingQuantity = 1\n      var quantity = item.quantity === undefined ? missingQuantity : toNumber(item.quantity);\n\n      if (!isFinite(price) || price < 0 ||\n          !isFinite(quantity) || quantity <= 0 || Math.floor(quantity) !== quantity) {\n        console.warn(\"add_to_cart not sent: item \" + i + \" has an invalid price or quantity.\", item);\n        return;\n      }\n\n      var priceCents = Math.round(price * 100);\n      var taxCents = Math.round(priceCents * 21 / 100);\n\n      totalCents += (priceCents + taxCents) * quantity;\n\n      updatedItems.push(Object.assign({}, item, {\n        price: priceCents / 100,\n        quantity: quantity,\n        tax: taxCents / 100\n      }));\n    }\n\n    if (updatedItems.length === 0) {\n      console.warn(\"add_to_cart not sent: items list is empty.\");\n      return;\n    }\n\n    console.log(\"Updated items:\", updatedItems);\n\n    var totalValue = totalCents / 100;\n\n    console.log(\"Total value with tax:\", totalValue);\n\n    window.dataLayer = window.dataLayer || [];\n\n    window.dataLayer.push({ ecommerce: null });\n\n    window.dataLayer.push({\n      event: \"add_to_cart\",\n      ecommerce: {\n        value: totalValue,\n        currency: eventParams.currency,\n        items: updatedItems\n      }\n    });\n\n    console.log(\"Transformed add_to_cart event pushed!\");\n  })();\n</script>"
